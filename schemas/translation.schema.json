{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "translation",
  "description": "게임 한글화 키트 v1.0.0 데이터 계약",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_pack_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "context_pack_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "translation_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ko": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "l1_approved",
        "release_approved"
      ]
    },
    "translator_role": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "carried_from": {
      "description": "게임 업데이트 승인 이월 출처. 내용이 같은 레코드의 직전 승인을 새 source revision에 옮겼음을 뜻하며 새 검수가 아니다.",
      "type": "object",
      "properties": {
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "source_revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "source_revision",
    "source_sha256",
    "context_pack_id",
    "context_pack_digest",
    "translation_revision",
    "ko",
    "status",
    "translator_role",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {},
      "else": {
        "properties": {
          "ko": {
            "type": "string"
          }
        }
      }
    }
  ]
}
